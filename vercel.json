{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "my-project-repo-HWSI-Heat-Water-Stress-Decision-Support-System-6b4d6d9/backend",
      "runtime": "python"
    },
    "frontend": {
      "root": "my-project-repo-HWSI-Heat-Water-Stress-Decision-Support-System-6b4d6d9/frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
